{
  "id": "keepdeck.opencode",
  "name": "OpenCode",
  "version": "0.6.0",
  "minApiVersion": 37,
  "category": "cli",
  "description": "Teaches KeepDeck the OpenCode CLI: identity and detection, spawn/resume/fork with session relocation, session-store history, pane usage, and team mail delivered into the session itself.",
  "capabilities": [
    { "kind": "exec", "commands": ["opencode"] },
    { "kind": "sqliteReadonly", "paths": ["~/.local/share/opencode"] },
    { "kind": "fs", "scope": "everywhere" },
    { "kind": "fsWrite", "paths": ["/tmp/keepdeck-opencode", "/private/tmp/keepdeck-opencode"] },
    { "kind": "notifications" }
  ],
  "contributes": {
    "agents": [
      {
        "id": "opencode",
        "label": "OpenCode",
        "bin": "opencode",
        "features": [
          { "id": "session.new", "label": "New sessions", "group": "sessions" },
          {
            "id": "session.resume",
            "label": "Resume saved sessions",
            "group": "sessions"
          },
          {
            "id": "session.fork",
            "label": "Fork sessions",
            "group": "sessions"
          },
          {
            "id": "session.history",
            "label": "Session history",
            "group": "sessions"
          },
          {
            "id": "usage.pane",
            "label": "Session analytics",
            "group": "usage"
          },
          {
            "id": "execution.yolo",
            "label": "YOLO mode",
            "group": "execution"
          },
          {
            "id": "target.remote",
            "label": "Remote targets",
            "group": "execution",
            "parameters": { "schemes": ["http", "https"] }
          }
        ]
      }
    ]
  }
}

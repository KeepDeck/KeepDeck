{
  "id": "keepdeck.claude",
  "name": "Claude Code",
  "version": "0.7.2",
  "minApiVersion": 37,
  "category": "cli",
  "description": "Teaches KeepDeck the Claude Code CLI: catalog identity and detection; spawn, resume and session identity move in next.",
  "capabilities": [
    { "kind": "exec", "commands": ["claude"] },
    { "kind": "fs", "scope": "everywhere" },
    { "kind": "fsWrite", "paths": ["~/.claude/projects"] }
  ],
  "contributes": {
    "agents": [
      {
        "id": "claude",
        "label": "Claude Code",
        "bin": "claude",
        "features": [
          { "id": "session.new", "label": "New sessions", "group": "sessions" },
          {
            "id": "session.resume",
            "label": "Resume saved sessions",
            "group": "sessions"
          },
          {
            "id": "session.fork",
            "label": "Fork sessions",
            "group": "sessions"
          },
          {
            "id": "session.history",
            "label": "Session history",
            "group": "sessions"
          },
          {
            "id": "usage.pane",
            "label": "Session analytics",
            "group": "usage"
          },
          {
            "id": "usage.account",
            "label": "Account limits",
            "group": "usage"
          },
          {
            "id": "execution.yolo",
            "label": "YOLO mode",
            "group": "execution"
          }
        ]
      }
    ]
  }
}

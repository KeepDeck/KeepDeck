{
  "id": "keepdeck.kimi",
  "name": "Kimi Code",
  "version": "0.11.0",
  "minApiVersion": 70,
  "category": "cli",
  "description": "Adds the Kimi Code CLI with exact session resume and an optional one-time setup for session persistence.",
  "capabilities": [
    { "kind": "exec", "commands": ["kimi", "/bin/sh"] },
    { "kind": "env", "names": ["KIMI_CODE_HOME", "KIMI_CODE_BASE_URL"] },
    { "kind": "net", "domains": ["127.0.0.1"] },
    {
      "kind": "net",
      "domains": [
        "api.kimi.com",
        "api.kimi.ai",
        { "env": "KIMI_CODE_BASE_URL", "default": "https://api.kimi.com/coding/v1" }
      ],
      "credentials": [
        {
          "id": "kimi-code",
          "dir": { "env": "KIMI_CODE_HOME", "default": "~/.kimi-code", "append": "credentials" },
          "tokenFields": ["access_token", "accessToken"]
        }
      ]
    },
    { "kind": "notifications" },
    { "kind": "fs", "scope": "everywhere" },
    { "kind": "fsWrite", "paths": ["~/.kimi-code"] }
  ],
  "contributes": {
    "agents": [
      {
        "id": "kimi",
        "label": "Kimi Code",
        "bin": "kimi",
        "features": [
          { "id": "session.new", "label": "New sessions", "group": "sessions" },
          {
            "id": "session.resume",
            "label": "Resume saved sessions",
            "group": "sessions"
          },
          {
            "id": "session.fork",
            "label": "Fork sessions",
            "group": "sessions"
          },
          {
            "id": "session.history",
            "label": "Session history",
            "group": "sessions"
          },
          {
            "id": "usage.pane",
            "label": "Session analytics",
            "group": "usage"
          },
          {
            "id": "usage.account",
            "label": "Account limits",
            "group": "usage"
          },
          {
            "id": "execution.yolo",
            "label": "YOLO mode",
            "group": "execution"
          },
          {
            "id": "integration.mcp",
            "label": "MCP servers from the library",
            "group": "integration"
          },
          {
            "id": "integration.skills",
            "label": "Skills from the library",
            "group": "integration"
          },
          {
            "id": "mail.turn-end",
            "label": "Mail at the turn boundary",
            "group": "mail"
          }
        ]
      }
    ],
    "settings": true
  }
}

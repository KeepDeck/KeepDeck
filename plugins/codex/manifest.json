{
  "id": "keepdeck.codex",
  "name": "Codex",
  "version": "0.3.1",
  "minApiVersion": 32,
  "category": "cli",
  "description": "Teaches KeepDeck the Codex CLI: catalog identity and detection; spawn, resume and session identity move in next.",
  "capabilities": [
    { "kind": "exec", "commands": ["codex"] },
    { "kind": "fs", "scope": "everywhere" }
  ],
  "contributes": {
    "agents": [
      {
        "id": "codex",
        "label": "Codex",
        "bin": "codex",
        "features": [
          { "id": "session.new", "label": "New sessions", "group": "sessions" },
          {
            "id": "session.resume",
            "label": "Resume saved sessions",
            "group": "sessions"
          },
          {
            "id": "session.fork",
            "label": "Fork sessions",
            "group": "sessions"
          },
          {
            "id": "session.history",
            "label": "Session history",
            "group": "sessions"
          },
          {
            "id": "usage.pane",
            "label": "Session analytics",
            "group": "usage"
          },
          {
            "id": "usage.account",
            "label": "Account limits",
            "group": "usage"
          },
          {
            "id": "execution.yolo",
            "label": "YOLO mode",
            "group": "execution"
          },
          {
            "id": "target.remote",
            "label": "Remote targets",
            "group": "execution",
            "parameters": { "schemes": ["ws", "wss"] }
          }
        ]
      }
    ]
  }
}

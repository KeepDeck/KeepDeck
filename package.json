{
  "name": "keepdeck",
  "private": true,
  "version": "0.31.50",
  "packageManager": "pnpm@10.28.0",
  "description": "Desktop deck for a fleet of coding agents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint && pnpm typecheck && vite build && node scripts/build-plugins.mjs && node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/check-plugin-bundles.mjs dist",
    "build:plugins": "node scripts/build-plugins.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:q1:diagnose": "node scripts/q1-diagnose.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.refresh.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint",
    "lint:shell": "git ls-files -z '*.sh' ':!:resources/reporters/lib/*.sh' | xargs -0 shellcheck -x",
    "tauri": "tauri",
    "build:macos": "./build-macos.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@keepdeck/plugin-api": "workspace:*",
    "@keepdeck/terminal-kit": "workspace:*",
    "@keepdeck/ui-kit": "workspace:*",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "happy-dom": "^20.10.6",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
